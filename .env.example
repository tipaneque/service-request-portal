####################################################################
# Service Request Portal - environment configuration
#
# Copy this file to `.env.local` and adjust the values. Never commit
# a file that contains real credentials; `.env*.local` is git-ignored.
#
# Only variables prefixed with `VITE_` reach the browser bundle, and
# everything in that bundle is public. Do not put a client secret,
# an API key or any other secret in this file: the browser client
# uses Authorization Code flow with PKCE precisely so that it does
# not need one.
####################################################################

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------

# Base URL of the Service Request API, without a trailing slash.
# Every path from the OpenAPI document is appended to it
# (e.g. `/requests`). A relative value such as `/api` is served by the
# same origin - useful behind a reverse proxy or with the mock worker.
VITE_API_BASE_URL=/api

# `true`  - Mock Service Worker intercepts API calls in the browser and
#           serves the in-memory dataset. No backend needed.
# `false` - Requests go to VITE_API_BASE_URL for real.
VITE_ENABLE_API_MOCKS=true

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------

# `oidc` - real OpenID Connect provider (Keycloak, Auth0, Entra ID, ...).
# `mock` - local demo session, for development and automated tests only.
#          Never use `mock` in a deployed environment.
VITE_AUTH_MODE=mock

# Production builds refuse to run with mock authentication by default. This
# escape hatch is only for a deliberately published demo, never a real portal.
VITE_ALLOW_MOCK_AUTH_IN_PRODUCTION=false

# Issuer URL of the OIDC provider. The client discovers endpoints from
# `${VITE_OIDC_AUTHORITY}/.well-known/openid-configuration`.
#   Keycloak: https://keycloak.example.com/realms/service-desk
#   Auth0:    https://your-tenant.eu.auth0.com
VITE_OIDC_AUTHORITY=

# Public client id registered with the provider.
VITE_OIDC_CLIENT_ID=service-request-portal

# Must match a redirect URI registered with the provider exactly.
# Defaults to `${window.location.origin}/auth/callback` when left empty.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Where the provider sends the user after sign-out.
# Defaults to `${window.location.origin}` when left empty.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# Scopes requested at sign-in. Add the API scope your deployment uses,
# e.g. `openid profile email service-requests.read service-requests.write`.
VITE_OIDC_SCOPE=openid profile email

# Optional. Providers such as Auth0 need an audience to issue a JWT access
# token for the API instead of an opaque one. Leave empty for Keycloak.
VITE_OIDC_AUDIENCE=
